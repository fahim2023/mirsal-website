---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Button from '../components/Button.astro';
import { t, link, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const th = d.thanks;
---
<Base lang={lang} page="thanks" title={th.title}>
  <meta slot="head" name="robots" content="noindex" />
  <section class="relative overflow-hidden px-5 py-28 sm:px-10 md:py-44 lg:px-16">
    <svg aria-hidden="true" width="620" height="620" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.035"
      class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-gold opacity-60">
      <rect x="5" y="5" width="14" height="14" /><rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)" /><circle cx="12" cy="12" r="9.9" />
    </svg>
    <div class="relative mx-auto flex max-w-[760px] flex-col items-center gap-6.5 text-center">
      <Mark size={72} />
      <p lang={lang === 'ar' ? 'en' : 'ar'} class="m-0 font-display text-3xl text-gold" style={lang === 'ar' ? "font-family:'Cormorant Garamond',serif" : "font-family:'El Messiri',serif"}>{th.arabic}</p>
      <h1 class="m-0 font-display text-[clamp(40px,5vw,68px)] leading-[1.08] font-normal rtl:leading-[1.45] rtl:font-medium">{th.h1}</h1>
      <p class="m-0 max-w-[32em] text-lg text-muted">{th.text}</p>
      <div class="flex flex-wrap justify-center gap-3.5">
        <Button href={d.contactInfo.whatsappLink}>{th.primary}</Button>
        <Button href={link(lang, 'services')} variant="ghost">{th.secondary}</Button>
      </div>
    </div>
  </section>
</Base>
