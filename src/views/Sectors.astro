---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import type { PhotoKey } from '../data/images';
const sectorPhotos: PhotoKey[] = ['riyadh', 'car', 'dates'];
import Bullets from '../components/Bullets.astro';
import Button from '../components/Button.astro';
import { t, link, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).sectors;
---
<Base lang={lang} page="sectors" title={s.title}>
  <PageHero eyebrow={s.eyebrow} title={s.h1} text={s.text} />

  <section class="px-5 pb-20 sm:px-10 md:pb-28 lg:px-16">
    <div class="mx-auto max-w-[1180px]">
      {s.items.map((it, i) => (
        <div class:list={['flex flex-wrap items-center gap-x-18 gap-y-10 border-t border-line py-16', i % 2 === 1 && 'flex-row-reverse']}>
          <div class="flex-[1_1_400px]"><Photo name={sectorPhotos[i]} lang={lang} ratio="5 / 4" /></div>
          <div class="flex flex-[1_1_420px] flex-col gap-4.5">
            <span class="caps text-[11px] text-gold rtl:text-sm" set:html={it.k} />
            <h2 class="m-0 font-display text-[clamp(36px,4vw,56px)] leading-[1.08] font-normal rtl:leading-[1.45] rtl:font-medium">{it.t}</h2>
            <p class="m-0 text-[17px] text-muted">{it.d}</p>
            <Bullets items={it.bullets} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-panel px-5 py-16 sm:px-10 lg:px-16">
    <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-12 gap-y-6">
      <h2 class="m-0 font-display text-[clamp(30px,3.4vw,46px)] font-normal rtl:font-medium">{s.otherTitle}</h2>
      <Button href={link(lang, 'contact')}>{s.otherCta}</Button>
    </div>
  </section>
</Base>
