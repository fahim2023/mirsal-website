---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Button from '../components/Button.astro';
import { t, link, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const n = t(lang).notFound;
---
<Base lang={lang} page="" title={n.title}>
  <section class="px-5 py-32 sm:px-10 md:py-44 lg:px-16">
    <div class="mx-auto flex max-w-[640px] flex-col items-center gap-6 text-center">
      <Mark size={64} />
      <p class="m-0 font-display text-7xl text-gold">404</p>
      <h1 class="m-0 font-display text-[clamp(34px,4vw,52px)] font-normal rtl:font-medium">{n.h1}</h1>
      <p class="m-0 text-muted">{n.text}</p>
      <Button href={link(lang, '')}>{n.home}</Button>
    </div>
  </section>
</Base>
