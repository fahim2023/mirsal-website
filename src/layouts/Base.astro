---
// The page shell used by every page: <head>, header, footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, link, dir, type Lang, type Page } from '../i18n';

interface Props { lang: Lang; page: Page; title: string; description?: string }
const { lang, page, title, description } = Astro.props;
const d = t(lang);
const desc = description ?? d.meta.description;
const site = Astro.site ?? new URL('https://www.mirsal.example');
const canonical = new URL(link(lang, page), site).href;
const enUrl = new URL(link('en', page), site).href;
const arUrl = new URL(link('ar', page), site).href;
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <!-- Tells Google the English and Arabic versions are the same page -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0D0C0A" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_GB'} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-ink text-cream">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:text-ink">
      {lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}
    </a>
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
