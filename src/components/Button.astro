---
// Gold (primary) or outlined (ghost) link styled as a button.
interface Props { href: string; variant?: 'primary' | 'ghost'; class?: string }
const { href, variant = 'primary', class: cls = '' } = Astro.props;
const styles = {
  primary: 'bg-gold text-ink hover:bg-sand hover:text-ink font-semibold',
  ghost: 'border border-line-strong text-cream hover:border-gold font-medium',
};
---
<a href={href} class:list={['caps inline-flex min-h-13 items-center justify-center gap-3 px-7 py-4 text-[13px] no-underline transition-colors rtl:text-base', styles[variant], cls]}>
  <slot />
</a>
