---
// Mirsal's logo mark: an eight-pointed star with a solid gold diamond at its centre.
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.9"
  class:list={['shrink-0 text-gold', cls]}>
  <rect x="4.5" y="4.5" width="15" height="15" />
  <rect x="4.5" y="4.5" width="15" height="15" transform="rotate(45 12 12)" />
  <rect x="9.4" y="9.4" width="5.2" height="5.2" fill="currentColor" stroke="none" transform="rotate(45 12 12)" />
</svg>
