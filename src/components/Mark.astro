---
// Mirsal's logo mark: an eight-pointed star with a circle and the letter م at its centre.
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<span aria-hidden="true" class:list={['relative inline-flex shrink-0 items-center justify-center text-gold', cls]} style={`width:${size}px;height:${size}px`}>
  <svg class="absolute inset-0" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.9">
    <rect x="4.5" y="4.5" width="15" height="15" />
    <rect x="4.5" y="4.5" width="15" height="15" transform="rotate(45 12 12)" />
    <circle cx="12" cy="12" r="5.2" />
  </svg>
  <span class="relative leading-none font-semibold" style={`font-family:'El Messiri',serif;font-size:${Math.round(size * 0.34)}px;transform:translateY(-0.08em)`}>م</span>
</span>
