---
// The eight-pointed star used as Mirsal's ornament.
interface Props { size?: number; class?: string; stroke?: number }
const { size = 22, class: cls = '', stroke = 1 } = Astro.props;
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} class:list={['text-gold', cls]}>
  <rect x="5" y="5" width="14" height="14" />
  <rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)" />
</svg>
