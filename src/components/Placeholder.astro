---
// A labelled stand-in for a photograph. Replace with <img> or Astro's <Image> when you have real photos.
interface Props { label: string; ratio?: string; class?: string; arch?: boolean; labelTop?: boolean }
const { label, ratio = '4 / 3', class: cls = '', arch = false, labelTop = false } = Astro.props;
const id = `p${Math.random().toString(36).slice(2, 8)}`;
---
<div role="img" aria-label={label.replace(/&amp;/g, '&')}
  class:list={['relative flex overflow-hidden border border-line p-4.5 bg-[linear-gradient(160deg,#2A241A_0%,#17140F_55%,#0F0D0A_100%)]', labelTop ? 'items-start justify-end pt-28' : 'items-end', arch && 'rounded-t-full', cls]}
  style={`aspect-ratio:${ratio}`}>
  <svg aria-hidden="true" class="absolute inset-0 h-full w-full opacity-20">
    <defs>
      <pattern id={id} width="48" height="48" patternUnits="userSpaceOnUse">
        <rect x="14" y="14" width="20" height="20" fill="none" stroke="#C8A15A" stroke-width="0.6" />
        <rect x="14" y="14" width="20" height="20" fill="none" stroke="#C8A15A" stroke-width="0.6" transform="rotate(45 24 24)" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
  <span class="caps relative text-xs text-muted" set:html={label} />
</div>
