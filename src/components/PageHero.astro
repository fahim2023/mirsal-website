---
// Large heading at the top of inner pages.
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow: string; title: string; text: string }
const { eyebrow, title, text } = Astro.props;
---
<section class="relative overflow-hidden px-5 pt-20 pb-14 sm:px-10 md:pt-36 md:pb-24 lg:px-16">
  <svg aria-hidden="true" width="620" height="620" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.035"
    class="pointer-events-none absolute -top-36 -end-36 text-gold opacity-60">
    <rect x="5" y="5" width="14" height="14" /><rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)" /><circle cx="12" cy="12" r="9.9" />
  </svg>
  <div class="relative mx-auto flex max-w-[1180px] flex-col gap-6">
    <Eyebrow text={eyebrow} />
    <h1 class="m-0 max-w-[14em] font-display text-[clamp(44px,6vw,88px)] leading-[1.06] font-normal rtl:leading-[1.45] rtl:font-medium" set:html={title} />
    <p class="m-0 max-w-[34em] text-[clamp(17px,1.5vw,20px)] text-muted" set:html={text} />
  </div>
</section>
